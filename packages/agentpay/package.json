{
  "name": "@graphpay_ethglobal/agentpay",
  "version": "1.0.0",
  "type": "module",
  "description": "AgentPay: a two-sided SDK for agentic USDT payments on Whitechain Sepolia. An AI agent pays an HTTP 402 with one signature and no gas under an on-chain spending pass; a merchant prices any route, settles through a facilitator and gets paid.",
  "license": "MIT",
  "author": "GraphPay",
  "homepage": "https://github.com/Zugzwang-world/graphpay/tree/main/packages/agentpay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zugzwang-world/graphpay.git",
    "directory": "packages/agentpay"
  },
  "bugs": {
    "url": "https://github.com/Zugzwang-world/graphpay/issues/new?template=agentpay-feedback.yml"
  },
  "keywords": [
    "x402",
    "http-402",
    "agent-payments",
    "ai-agents",
    "usdt",
    "stablecoin",
    "whitechain",
    "mcp",
    "permit2",
    "eip-712"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./sandbox": {
      "types": "./sandbox.d.ts",
      "default": "./sandbox.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "files": [
    "index.mjs",
    "index.d.ts",
    "sandbox.mjs",
    "sandbox.d.ts",
    "src",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "FEEDBACK.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:fork": "node --test --test-concurrency=1 \"test-fork/*.test.mjs\"",
    "vendor": "node scripts/vendor.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ai": "7.0.162",
    "viem": "2.57.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@x402/core": "2.30.0"
  }
}
