  "demoScript": [
    {
      "step": 1,
      "at": "0:00-0:20",
      "action": "The stage; one line: \"Your next customer is an agent. Ask before you pay.\"",
      "proves": "the pitch"
    },
    {
      "step": 2,
      "at": "0:20-1:10",
      "action": "Vitalik's request; the team fans out; the analyst's one GraphQL call (2 reads); the trap shop vetoed in red; the good shop chosen",
      "proves": "agents, guards in code, Graph Arkiv"
    },
    {
      "step": 3,
      "at": "1:10-1:45",
      "action": "The 402, the signature, the settlement; you paid no gas; the explorer page opens",
      "proves": "x402 on Whitechain, our facilitator"
    },
    {
      "step": 4,
      "at": "1:45-2:10",
      "action": "The merchant's phone rings; the buyer's ENS name and reputation; mark dispatched",
      "proves": "ENS identity, merchant view"
    },
    {
      "step": 5,
      "at": "2:10-2:35",
      "action": "The Arkiv write as dots and lines; the GraphQL answer with its exact reads",
      "proves": "Arkiv as the memory"
    },
    {
      "step": 6,
      "at": "2:35-3:00",
      "action": "Refund request, partial refund; re-order; renewal in the demo period",
      "proves": "refunds, renewals"
    },
    {
      "step": 7,
      "at": "3:00-3:25",
      "action": "Pause my agent: refused within 20 s of the Sepolia receipt; resume",
      "proves": "the ENS kill switch"
    },
    {
      "step": 8,
      "at": "3:25-3:50",
      "action": "Race mode at the largest seeded city: the reads each side needs",
      "proves": "the benchmark (reads, not speed)"
    },
    {
      "step": 9,
      "at": "3:50-4:00",
      "action": "The demo store's 20 lines; links",
      "proves": "drop-in checkout"
    }
  ],
