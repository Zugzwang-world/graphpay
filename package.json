{
  "name": "graphpay",
  "private": true,
  "type": "module",
  "description": "GraphPay: ask before you pay. Agents with ENS names pay shops over x402 on Whitechain; every payment joins a money graph on Arkiv.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "check": "node scripts/check.mjs",
    "syntax": "node scripts/syntax.mjs",
    "test": "node --test \"scripts/test/*.test.mjs\" && pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "contracts:libs": "sh packages/contracts/install-libs.sh",
    "secrets:set": "node scripts/secrets/set.mjs",
    "secrets:stdin": "node scripts/secrets/set-from-stdin.mjs",
    "secrets:gen": "node scripts/secrets/gen-secret.mjs",
    "secrets:status": "node scripts/secrets/status.mjs",
    "secrets:import-lab": "node scripts/secrets/import-lab.mjs",
    "wallet:gen": "node scripts/secrets/gen-wallet.mjs",
    "wallets:addresses": "node scripts/wallets/addresses.mjs",
    "funding": "node scripts/funding/fund.mjs"
  },
  "devDependencies": {
    "viem": "2.57.16"
  }
}
