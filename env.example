# Names only (SPEC/SECURITY_AND_OPS.md §3b). Values live in the git-ignored .env
# and, for hosted services, in the Vercel environment as Sensitive values.
# `pnpm secrets:status` lists every name below as set or missing.

# Role keys (planning/WALLETS.md §1; docs/technical/WALLETS.md for the event addresses)
FUNDER_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
FACILITATOR_PRIVATE_KEY=
RENEWER_PRIVATE_KEY=
POLICY_WRITER_PRIVATE_KEY=
W_SYNC_PRIVATE_KEY=
W_LEDGER_PRIVATE_KEY=
W_DIRECTORY_PRIVATE_KEY=
W_SEED_EVENT_PRIVATE_KEY=
W_SEED_M_EVENT_PRIVATE_KEY=
VITALIK_PRIVATE_KEY=
SHOP_KESAR_PRIVATE_KEY=
SHOP_JAMUN_PRIVATE_KEY=
SHOP_SYRUP_PRIVATE_KEY=
PAYER_PRIVATE_KEY=
DEAL_HUNTER_PRIVATE_KEY=
REHEARSAL_PAYER_PRIVATE_KEY=
ACCEPTANCE_PAYER_PRIVATE_KEY=
# One per kill, generated when needed: DISPOSABLE_<n>_PRIVATE_KEY (n = 1, 2, ...)
DISPOSABLE_1_PRIVATE_KEY=

# Imported credentials
ARKIV_ACCESS_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
# Kimi (Moonshot AI), the agents' provider (ADR-0067; international platform, https://api.moonshot.ai/v1). Server-only: never a NEXT_PUBLIC_ or VITE_ name.
KIMI_API_KEY=

# Generated secrets (at least 24 characters). Under public access (ADR-0069) visitors need no
# passcode, but our own servers still send DEMO_PASSCODE to the shop's pay route: keep it set.
DEMO_PASSCODE=
FACILITATOR_AUTH_TOKEN=
RECORDER_TOKEN=
CRON_SECRET=

# Networks. WHITECHAIN_RPC_URL is a server-only secret (a keyed Ankr URL); without it
# the code falls back to the public URLs in packages/config/graphpay.config.json.
WHITECHAIN_RPC_URL=
SEPOLIA_RPC_URL=
ARKIV_RPC_URL=
ALLOW_REAL_NETWORK=

# Contract and token
GRAPHPAY_CONTRACT=
GRAPHPAY_TOKEN=
GRAPHPAY_TOKEN_NAME=
GRAPHPAY_TOKEN_VERSION=
DEPLOY_BLOCK=
CONFIRMATIONS=

# Facilitator and shop
ALLOWED_MERCHANTS=
SHOP_MERCHANTS=
MAX_SETTLE_GAS=
GAS_BUDGET_DAILY_WBT=
MIN_RELAYER_BALANCE_WBT=
RECORDED_FAILURES_PER_DAY=
RECEIPT_TIMEOUT_MS=
FACILITATOR_URL=
ATTEMPTS_URL=

# ENS
GRAPHPAY_ROOT_ENS=
ENS_ALLOWED_ROOTS=
ENS_GATE_TTL_MS=

# Arkiv and mirror
ARKIV_BACKEND=
MIRROR_SYNTHETIC=
BOOTSTRAP_FILE=
DELIVERY_PROMISE_S=
RECORDER_OWNER=

# Agents and e2e. E2E_MODEL is the e2e switch (mock, anthropic or auto), not a model id;
# model ids and effort come from the story config's presets (AGENT_PRESET below).
AGENT_MODE=
AGENT_PROVIDER=
E2E_BUYER=
E2E_MODEL=
E2E_KILL=
E2E_NETWORK=
E2E_HISTORY_SCALE=

# Agent model preset for one run (optional; the story config's agentModels.active wins when unset)
AGENT_PRESET=

# Optional, not a secret: GRAPHPAY_PUBLIC_ACCESS=0 closes the site's routes behind the passcode again
# (packages/config site.publicAccess opens them; the env can only close them).
GRAPHPAY_PUBLIC_ACCESS=
