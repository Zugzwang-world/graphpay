{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../../packages ../../integration ../../frontend ../../apps/phones ../../package.json ../../pnpm-workspace.yaml ../../pnpm-lock.yaml ../../.node-version ../../tsconfig.base.json ../../.vercelignore",
  "crons": [
    {
      "path": "/api/cron/renew",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/heal",
      "schedule": "* * * * *"
    }
  ]
}
